# data/raw/ (~18 MB of open datasets) IS committed so the app runs offline right after cloning
# generated artefacts (re-create with: python -m src.pipeline)
data/processed/
models/

# python environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# python caches & compiled bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
parts/
sdist/
wheels/
*.egg-info/
.installed.cfg
*.egg

# testing, linting, type-checking & notebooks
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.ipynb_checkpoints/

# web / node
node_modules/
web/node_modules/
